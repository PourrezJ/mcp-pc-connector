# Copiez ce fichier en .env puis renseignez les valeurs.
# ATTENTION : .env ne doit JAMAIS être committé (voir .gitignore).

# Token Bearer requis par le serveur (401 si absent/invalide).
# Générez-en un fort, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_TOKEN=changez-moi-token-fort

# Port d'écoute (le serveur écoute sur 0.0.0.0).
PORT=9931

# Racines autorisées, séparées par ; ou , (tout chemin hors de ces racines est refusé).
ALLOWED_ROOTS=D:/Repos
